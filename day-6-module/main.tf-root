module "developer1" {
  source = "./modules/ec2"

  ami_id        = "YOUR_AMI_ID"
  instance_type = "t2.micro"
  name          = "Developer-EC2"
}

module "developer2_subnet" {
  source = "./modules/subnet"

  vpc_id            = var.vpc_id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "us-east-1b"
  name              = "Developer-2-Subnet"
}